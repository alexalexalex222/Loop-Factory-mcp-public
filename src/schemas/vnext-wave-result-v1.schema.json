{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop-factory-vnext-wave-result-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "seriesRunId", "waveId", "wavePlanSha256", "waveInputEvidenceSha256", "implementationSha256", "materializationSha256", "disposition", "taskPartition", "preparationDisposition", "preparationRunId", "preparationEvidenceSha256", "executionBindingSha256", "experimentRunId", "experimentPlanSha256", "experimentEvidenceSha256", "leaseEvidenceSha256", "importedRecordSha256", "importedRecordId", "evidenceLedgerSha256AtImport", "catalogMode", "catalogRecords", "causalPass", "activationEligible", "promotionAuthorized", "calls", "budgetLedgers", "recordedAt", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": "loop-factory-vnext-wave-result-v1" },
    "seriesRunId": { "$ref": "#/$defs/id" }, "waveId": { "$ref": "#/$defs/id" },
    "wavePlanSha256": { "$ref": "#/$defs/sha" }, "waveInputEvidenceSha256": { "$ref": "#/$defs/sha" }, "implementationSha256": { "$ref": "#/$defs/sha" }, "materializationSha256": { "$ref": "#/$defs/sha" },
    "disposition": { "enum": ["PREPARATION_REJECTED", "EXPERIMENT_VERIFIED"] },
    "taskPartition": { "enum": ["development", "validation"] },
    "preparationDisposition": { "type": "string", "minLength": 1, "maxLength": 120 },
    "preparationRunId": { "$ref": "#/$defs/id" }, "preparationEvidenceSha256": { "$ref": "#/$defs/sha" },
    "executionBindingSha256": { "$ref": "#/$defs/nullableSha" },
    "experimentRunId": { "$ref": "#/$defs/id" }, "experimentPlanSha256": { "$ref": "#/$defs/nullableSha" }, "experimentEvidenceSha256": { "$ref": "#/$defs/nullableSha" }, "leaseEvidenceSha256": { "$ref": "#/$defs/nullableSha" }, "importedRecordSha256": { "$ref": "#/$defs/nullableSha" },
    "importedRecordId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "evidenceLedgerSha256AtImport": { "$ref": "#/$defs/nullableSha" },
    "catalogMode": { "enum": ["development-only", "validation-routing", null] },
    "catalogRecords": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["schemaVersion", "state", "recordId", "recordSha256", "idempotent"],
        "properties": { "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 120 }, "state": { "type": ["string", "null"], "maxLength": 80 }, "recordId": { "$ref": "#/$defs/id" }, "recordSha256": { "$ref": "#/$defs/sha" }, "idempotent": { "type": "boolean" } }
      }
    },
    "causalPass": { "type": "boolean" }, "activationEligible": { "type": "boolean" }, "promotionAuthorized": { "const": false },
    "calls": { "type": "integer", "minimum": 0 },
    "budgetLedgers": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "vnext-resource-budget-ledger-v1.schema.json" } },
    "recordedAt": { "type": "string", "format": "date-time" }, "receiptSha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" }, "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "nullableSha": { "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] } }
}
