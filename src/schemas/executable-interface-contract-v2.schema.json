{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "executable-interface-contract-v2",
  "title": "Executable repair interface with exact semantic role bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportName",
    "inputPaths",
    "decisions",
    "codes",
    "roleBindings"
  ],
  "properties": {
    "schemaVersion": { "const": "executable-interface-contract-v2" },
    "exportName": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,79}$"
    },
    "inputPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/path" }
    },
    "decisions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["ACCEPT", "REJECT"] },
      "allOf": [
        { "contains": { "const": "ACCEPT" } },
        { "contains": { "const": "REJECT" } }
      ]
    },
    "codes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "meaning"],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,119}$"
          },
          "meaning": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          }
        }
      }
    },
    "roleBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path"],
        "properties": {
          "role": { "$ref": "#/definitions/role" },
          "path": { "$ref": "#/definitions/path" }
        }
      }
    }
  },
  "definitions": {
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}(\\.[a-z][a-z0-9-]{0,79})*$"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?(\\.[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?)*$"
    }
  }
}
