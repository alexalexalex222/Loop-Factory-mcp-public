{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "createdAt", "allowlist", "maximumQueries", "maximumSources", "maximumPerSourceBytes", "maximumTotalBytes", "timeoutMs", "networkEnabled", "sealedMode", "discoveryToolPolicy", "activationAuthority", "promotionAuthority", "policySha256"],
  "properties": {
    "schemaVersion": { "const": "vnext-external-research-policy-v1" },
    "policyId": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "allowlist": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" } },
    "maximumQueries": { "type": "integer", "minimum": 1, "maximum": 32 },
    "maximumSources": { "type": "integer", "minimum": 1, "maximum": 32 },
    "maximumPerSourceBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
    "maximumTotalBytes": { "type": "integer", "minimum": 1024, "maximum": 8388608 },
    "timeoutMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
    "networkEnabled": { "const": true },
    "sealedMode": { "const": false },
    "discoveryToolPolicy": { "const": "research-web-read-only" },
    "activationAuthority": { "const": false },
    "promotionAuthority": { "const": false },
    "policySha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
