{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mechanism-evolution-v1",
  "title": "Append-only bounded mechanism evolution lifecycle event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evolutionId",
    "evolutionReceiptId",
    "evolutionSha256",
    "state",
    "recordedAt",
    "previous",
    "parent",
    "candidate",
    "mutationPlan",
    "semanticDelta",
    "evidence",
    "outcome",
    "authority",
    "reasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": "mechanism-evolution-v1" },
    "evolutionId": { "type": "string", "pattern": "^evolution-[a-f0-9]{24}$" },
    "evolutionReceiptId": { "type": "string", "pattern": "^evolution-receipt-[a-f0-9]{24}$" },
    "evolutionSha256": { "$ref": "#/definitions/sha256" },
    "state": { "enum": ["PROPOSED", "SHADOW", "VERIFIED", "ACTIVE", "REJECTED"] },
    "recordedAt": { "type": "string", "format": "date-time" },
    "previous": {
      "anyOf": [
        { "$ref": "#/definitions/previous" },
        { "type": "null" }
      ]
    },
    "parent": { "$ref": "#/definitions/familyRef" },
    "candidate": { "$ref": "#/definitions/familyRef" },
    "mutationPlan": { "$ref": "mechanism-mutation-plan-v1.schema.json" },
    "semanticDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSemanticDelta",
        "parentSemanticSha256",
        "candidateSemanticSha256",
        "operationCount",
        "changedComponents"
      ],
      "properties": {
        "sourceSemanticDelta": { "const": true },
        "parentSemanticSha256": { "$ref": "#/definitions/sha256" },
        "candidateSemanticSha256": { "$ref": "#/definitions/sha256" },
        "operationCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "changedComponents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bindings",
              "fallback",
              "forbiddenBindings",
              "metrics",
              "rules",
              "selectors"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMeasurementId",
        "sourceMeasurementSha256",
        "treatmentDeltaSha256",
        "verificationMeasurementId",
        "verificationMeasurementSha256",
        "verifierEvidenceSha256",
        "activationEvidenceSha256",
        "rejectionEvidenceSha256"
      ],
      "properties": {
        "sourceMeasurementId": { "type": "string", "pattern": "^measurement-[a-f0-9]{24}$" },
        "sourceMeasurementSha256": { "$ref": "#/definitions/sha256" },
        "treatmentDeltaSha256": { "$ref": "#/definitions/nullableSha256" },
        "verificationMeasurementId": {
          "anyOf": [
            { "type": "string", "pattern": "^measurement-[a-f0-9]{24}$" },
            { "type": "null" }
          ]
        },
        "verificationMeasurementSha256": { "$ref": "#/definitions/nullableSha256" },
        "verifierEvidenceSha256": { "$ref": "#/definitions/nullableSha256" },
        "activationEvidenceSha256": { "$ref": "#/definitions/nullableSha256" },
        "rejectionEvidenceSha256": { "$ref": "#/definitions/nullableSha256" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactVsBaselineDelta",
        "exactVsParentDelta",
        "decisionVsParentDelta",
        "shamExactVsBaselineDelta",
        "targetRegressions",
        "controlRegressions"
      ],
      "properties": {
        "exactVsBaselineDelta": { "$ref": "#/definitions/nullableNumber" },
        "exactVsParentDelta": { "$ref": "#/definitions/nullableNumber" },
        "decisionVsParentDelta": { "$ref": "#/definitions/nullableNumber" },
        "shamExactVsBaselineDelta": { "$ref": "#/definitions/nullableNumber" },
        "targetRegressions": { "$ref": "#/definitions/nullableCount" },
        "controlRegressions": { "$ref": "#/definitions/nullableCount" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation", "verification", "activation", "promotionAuthorized"],
      "properties": {
        "mutation": { "const": "bounded-tool" },
        "verification": {
          "anyOf": [
            { "const": "independent-verifier" },
            { "type": "null" }
          ]
        },
        "activation": { "enum": ["none", "routing-only"] },
        "promotionAuthorized": { "const": false }
      }
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/reason" }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableSha256": {
      "anyOf": [
        { "$ref": "#/definitions/sha256" },
        { "type": "null" }
      ]
    },
    "nullableNumber": {
      "anyOf": [
        { "type": "number", "minimum": -1, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "nullableCount": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "reason": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_]{0,119}$" },
    "familyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "familySha256", "programSha256", "semanticSha256"],
      "properties": {
        "familyId": { "type": "string", "pattern": "^family-[a-f0-9]{24}$" },
        "familySha256": { "$ref": "#/definitions/sha256" },
        "programSha256": { "$ref": "#/definitions/sha256" },
        "semanticSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evolutionReceiptId", "evolutionSha256", "state"],
      "properties": {
        "evolutionReceiptId": { "type": "string", "pattern": "^evolution-receipt-[a-f0-9]{24}$" },
        "evolutionSha256": { "$ref": "#/definitions/sha256" },
        "state": { "enum": ["PROPOSED", "SHADOW", "VERIFIED", "ACTIVE", "REJECTED"] }
      }
    }
  }
}
