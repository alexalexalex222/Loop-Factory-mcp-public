{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "failureId", "summary", "behavior", "component", "symptoms", "environment", "sourceEvidence", "sealedDataIncluded", "activationAuthority"],
  "properties": {
    "schemaVersion": { "const": "vnext-normalized-failure-v1" },
    "failureId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "behavior": { "type": "string", "minLength": 1, "maxLength": 240 },
    "component": { "type": "string", "minLength": 1, "maxLength": 120 },
    "symptoms": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "environment": { "$ref": "#/$defs/jsonObject" },
    "sourceEvidence": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "schemaVersion", "sha256", "availableAt", "locator"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
          "sha256": { "$ref": "#/$defs/sha" },
          "availableAt": { "type": "string", "format": "date-time" },
          "locator": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "sealedDataIncluded": { "const": false },
    "activationAuthority": { "const": false }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "jsonObject": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
    "jsonValue": { "anyOf": [{ "type": "null" }, { "type": "boolean" }, { "type": "number" }, { "type": "string" }, { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } }, { "$ref": "#/$defs/jsonObject" }] }
  }
}
