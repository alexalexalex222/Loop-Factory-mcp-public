{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["findingId", "baselineSha256", "caseResults"],
  "properties": {
    "findingId": { "type": "string", "pattern": "^finding-[0-9]{3}$" },
    "baselineSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "caseResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "disposition", "code", "evidencePaths"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "evidencePaths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
