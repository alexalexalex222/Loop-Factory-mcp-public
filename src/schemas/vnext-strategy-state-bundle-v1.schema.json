{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "decisionAt", "sourceRecords", "states",
    "activationAuthority", "bundleSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "vnext-strategy-state-bundle-v1" },
    "decisionAt": { "type": "string", "format": "date-time" },
    "sourceRecords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "recordSha256", "availableAt", "proofEvidenceSha256"],
        "properties": {
          "recordId": { "$ref": "#/$defs/id" },
          "recordSha256": { "$ref": "#/$defs/sha" },
          "availableAt": { "type": "string", "format": "date-time" },
          "proofEvidenceSha256": { "$ref": "#/$defs/sha" }
        }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reflective-pareto", "bounded-skill", "bank-recombination"],
      "properties": {
        "reflective-pareto": { "$ref": "#/$defs/state" },
        "bounded-skill": { "$ref": "#/$defs/state" },
        "bank-recombination": { "$ref": "#/$defs/state" }
      }
    },
    "activationAuthority": { "const": false },
    "bundleSha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "state", "stateSha256", "reason"],
      "properties": {
        "ready": { "type": "boolean" },
        "state": {},
        "stateSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
