{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "statement", "mechanism", "targetBehavior", "component", "taskAgnostic", "prediction", "falsifier", "controls", "evidenceIds"],
  "properties": {
    "schemaVersion": { "const": "vnext-hypothesis-output-v1" },
    "statement": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "mechanism": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "targetBehavior": { "$ref": "#/$defs/text" },
    "component": { "type": "string", "minLength": 1, "maxLength": 120 },
    "taskAgnostic": { "type": "boolean" },
    "prediction": { "$ref": "#/$defs/text" },
    "falsifier": { "$ref": "#/$defs/text" },
    "controls": { "$ref": "#/$defs/textArray" },
    "evidenceIds": { "$ref": "#/$defs/idArray" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "textArray": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/text" } },
    "idArray": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" } }
  }
}
