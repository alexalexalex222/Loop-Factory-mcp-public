{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "runId", "createdAt", "repositoryRoot", "worktreePath", "statePath", "baseCommit", "contractSha256", "candidateSha256", "verificationSha256", "inputPacketSha256", "sandboxExecutableSha256", "sandboxProfileSha256", "networkAllowed", "mutations", "tests", "gitStatus", "diffCheckPassed", "patchSha256", "patchBytes", "activationAuthority", "promotionAuthority", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": "vnext-code-worktree-run-v1" },
    "status": { "const": "PASS" },
    "runId": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "repositoryRoot": { "$ref": "#/$defs/absolutePath" },
    "worktreePath": { "$ref": "#/$defs/absolutePath" },
    "statePath": { "$ref": "#/$defs/absolutePath" },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "contractSha256": { "$ref": "#/$defs/sha" },
    "candidateSha256": { "$ref": "#/$defs/sha" },
    "verificationSha256": { "$ref": "#/$defs/sha" },
    "inputPacketSha256": { "$ref": "#/$defs/sha" },
    "sandboxExecutableSha256": { "$ref": "#/$defs/sha" },
    "sandboxProfileSha256": { "$ref": "#/$defs/sha" },
    "networkAllowed": { "const": false },
    "mutations": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/mutation" } },
    "tests": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/test" } },
    "gitStatus": { "type": "string", "maxLength": 4000 },
    "diffCheckPassed": { "const": true },
    "patchSha256": { "$ref": "#/$defs/sha" },
    "patchBytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
    "activationAuthority": { "const": false },
    "promotionAuthority": { "const": false },
    "receiptSha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 2048 },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "beforeSha256", "afterSha256", "afterBytes"],
      "properties": {
        "target": { "type": "string", "minLength": 1, "maxLength": 500 },
        "beforeSha256": { "$ref": "#/$defs/sha" },
        "afterSha256": { "$ref": "#/$defs/sha" },
        "afterBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "executable", "executableSha256", "args", "argsSha256", "timeoutMs", "elapsedMs", "exitCode", "signal", "timedOut", "stdoutSha256", "stderrSha256", "stdoutPath", "stderrPath"],
      "properties": {
        "testId": { "$ref": "#/$defs/id" },
        "executable": { "$ref": "#/$defs/absolutePath" },
        "executableSha256": { "$ref": "#/$defs/sha" },
        "args": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 1000 } },
        "argsSha256": { "$ref": "#/$defs/sha" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "exitCode": { "const": 0 },
        "signal": { "type": "null" },
        "timedOut": { "const": false },
        "stdoutSha256": { "$ref": "#/$defs/sha" },
        "stderrSha256": { "$ref": "#/$defs/sha" },
        "stdoutPath": { "$ref": "#/$defs/absolutePath" },
        "stderrPath": { "$ref": "#/$defs/absolutePath" }
      }
    }
  }
}
