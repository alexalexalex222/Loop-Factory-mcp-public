{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rubricSha256", "measurements", "uncertainty", "protocolViolations"],
  "properties": {
    "schemaVersion": { "const": "vnext-evaluator-output-v1" },
    "rubricSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "score", "evidenceRefs", "confidence"],
        "properties": {
          "dimension": { "type": "string", "minLength": 1, "maxLength": 120 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
    "protocolViolations": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" } }
  }
}
