{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["loop", "title", "baselineContent", "evidenceRefs", "hypotheses"],
        "properties": {
          "loop": { "type": "string", "minLength": 3 },
          "title": { "type": "string", "minLength": 12 },
          "baselineContent": { "type": "string", "minLength": 120 },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "locator"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "locator": { "type": "string", "minLength": 1 }
              }
            }
          },
          "hypotheses": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "bottleneck", "operation", "expectedMovement", "falsifier"],
              "properties": {
                "title": { "type": "string", "minLength": 12 },
                "bottleneck": { "type": "string", "minLength": 24 },
                "operation": { "type": "string", "minLength": 24 },
                "expectedMovement": { "type": "string", "minLength": 24 },
                "falsifier": { "type": "string", "minLength": 24 }
              }
            }
          }
        }
      }
    }
  }
}
