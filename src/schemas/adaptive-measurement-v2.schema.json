{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adaptive-measurement-v2",
  "title": "Verifier-owned continuous paired measurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "measurementId",
    "measurementSha256",
    "profile",
    "authority",
    "source",
    "armRoles",
    "mechanismBindings",
    "taskCount",
    "caseCount",
    "derivedCaseLayoutSha256",
    "artifactSetSha256",
    "taskEvidence",
    "arms",
    "contrasts"
  ],
  "properties": {
    "schemaVersion": { "const": "adaptive-measurement-v2" },
    "measurementId": { "type": "string", "pattern": "^measurement-[a-f0-9]{24}$" },
    "measurementSha256": { "$ref": "#/definitions/sha256" },
    "profile": { "enum": ["retrieval-causal-v1", "recursive-causal-v1"] },
    "authority": { "const": "tool-derived-from-persisted-evaluations" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runId",
        "verifierEvidenceSha256",
        "evaluatorAuthoritySha256",
        "caseSetSha256"
      ],
      "properties": {
        "kind": { "$ref": "#/definitions/safeId" },
        "runId": { "$ref": "#/definitions/safeId" },
        "verifierEvidenceSha256": { "$ref": "#/definitions/sha256" },
        "evaluatorAuthoritySha256": { "$ref": "#/definitions/sha256" },
        "caseSetSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "armRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "parent", "sham", "treatment"],
      "properties": {
        "baseline": { "$ref": "#/definitions/safeId" },
        "parent": {
          "anyOf": [
            { "$ref": "#/definitions/safeId" },
            { "type": "null" }
          ]
        },
        "sham": { "$ref": "#/definitions/safeId" },
        "treatment": { "$ref": "#/definitions/safeId" }
      }
    },
    "mechanismBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "parent", "sham", "treatment"],
      "properties": {
        "baseline": { "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
        "parent": { "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
        "sham": { "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
        "treatment": { "$ref": "#/definitions/sha256" }
      }
    },
    "taskCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "caseCount": { "type": "integer", "minimum": 1 },
    "derivedCaseLayoutSha256": { "$ref": "#/definitions/sha256" },
    "artifactSetSha256": { "$ref": "#/definitions/sha256" },
    "taskEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/definitions/taskEvidence" }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 3,
      "maxProperties": 4,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$": { "$ref": "#/definitions/armSummary" }
      }
    },
    "contrasts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shamVsBaseline",
        "treatmentVsBaseline",
        "treatmentVsParent",
        "treatmentVsSham"
      ],
      "properties": {
        "shamVsBaseline": { "$ref": "#/definitions/contrast" },
        "treatmentVsBaseline": { "$ref": "#/definitions/contrast" },
        "treatmentVsParent": {
          "anyOf": [
            { "$ref": "#/definitions/contrast" },
            { "type": "null" }
          ]
        },
        "treatmentVsSham": { "$ref": "#/definitions/contrast" }
      }
    }
  },
  "definitions": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "countGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "exact", "decisions", "codes"],
      "properties": {
        "cases": { "type": "integer", "minimum": 0 },
        "exact": { "type": "integer", "minimum": 0 },
        "decisions": { "type": "integer", "minimum": 0 },
        "codes": { "type": "integer", "minimum": 0 }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "decision", "code", "targetExact", "controlExact", "fullRepair"],
      "properties": {
        "exact": { "type": "number", "minimum": 0, "maximum": 1 },
        "decision": { "type": "number", "minimum": 0, "maximum": 1 },
        "code": { "type": "number", "minimum": 0, "maximum": 1 },
        "targetExact": { "type": "number", "minimum": 0, "maximum": 1 },
        "controlExact": { "type": "number", "minimum": 0, "maximum": 1 },
        "fullRepair": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "armSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "fullRepairs", "target", "control", "total", "tokenCost", "rates"],
      "properties": {
        "tasks": { "type": "integer", "minimum": 1 },
        "fullRepairs": { "type": "integer", "minimum": 0 },
        "target": { "$ref": "#/definitions/countGroup" },
        "control": { "$ref": "#/definitions/countGroup" },
        "total": { "$ref": "#/definitions/countGroup" },
        "tokenCost": { "type": "integer", "minimum": 1 },
        "rates": { "$ref": "#/definitions/rates" }
      }
    },
    "taskArmEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationArtifactRef",
        "evaluationArtifactSha256",
        "tokenCost",
        "targetCases",
        "controlCases"
      ],
      "properties": {
        "evaluationArtifactRef": { "$ref": "#/definitions/safeId" },
        "evaluationArtifactSha256": { "$ref": "#/definitions/sha256" },
        "tokenCost": { "type": "integer", "minimum": 1 },
        "targetCases": { "type": "integer", "minimum": 1 },
        "controlCases": { "type": "integer", "minimum": 1 }
      }
    },
    "taskEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "caseLayoutSha256", "arms"],
      "properties": {
        "taskId": { "$ref": "#/definitions/safeId" },
        "caseLayoutSha256": { "$ref": "#/definitions/sha256" },
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 3,
          "maxProperties": 4,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$": { "$ref": "#/definitions/taskArmEvidence" }
          }
        }
      }
    },
    "confidence95": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number", "minimum": -1, "maximum": 1 },
        "upper": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "pairedMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleSize",
        "referenceSuccesses",
        "treatmentSuccesses",
        "wins",
        "regressions",
        "delta",
        "standardError",
        "confidence95",
        "method",
        "unit"
      ],
      "properties": {
        "sampleSize": { "type": "integer", "minimum": 1 },
        "referenceSuccesses": { "type": "integer", "minimum": 0 },
        "treatmentSuccesses": { "type": "integer", "minimum": 0 },
        "wins": { "type": "integer", "minimum": 0 },
        "regressions": { "type": "integer", "minimum": 0 },
        "delta": { "type": "number", "minimum": -1, "maximum": 1 },
        "standardError": { "type": ["number", "null"], "minimum": 0 },
        "confidence95": {
          "anyOf": [
            { "$ref": "#/definitions/confidence95" },
            { "type": "null" }
          ]
        },
        "method": { "const": "paired-normal-approximation" },
        "unit": { "enum": ["case", "task"] }
      }
    },
    "metricSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "decision", "code", "targetExact", "controlExact", "fullRepair"],
      "properties": {
        "exact": { "$ref": "#/definitions/pairedMetric" },
        "decision": { "$ref": "#/definitions/pairedMetric" },
        "code": { "$ref": "#/definitions/pairedMetric" },
        "targetExact": { "$ref": "#/definitions/pairedMetric" },
        "controlExact": { "$ref": "#/definitions/pairedMetric" },
        "fullRepair": { "$ref": "#/definitions/pairedMetric" }
      }
    },
    "tokenCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "treatment", "absoluteDelta", "relativeDelta"],
      "properties": {
        "reference": { "type": "integer", "minimum": 1 },
        "treatment": { "type": "integer", "minimum": 1 },
        "absoluteDelta": { "type": "integer" },
        "relativeDelta": { "type": "number" }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceArm",
        "treatmentArm",
        "metrics",
        "targetRegressions",
        "controlRegressions",
        "tokenCost"
      ],
      "properties": {
        "referenceArm": { "$ref": "#/definitions/safeId" },
        "treatmentArm": { "$ref": "#/definitions/safeId" },
        "metrics": { "$ref": "#/definitions/metricSet" },
        "targetRegressions": { "type": "integer", "minimum": 0 },
        "controlRegressions": { "type": "integer", "minimum": 0 },
        "tokenCost": { "$ref": "#/definitions/tokenCost" }
      }
    }
  }
}
