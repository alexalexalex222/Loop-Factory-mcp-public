{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "seriesId", "createdAt", "maximumWaves", "familywiseAlpha", "perWaveAlpha", "maximumCalls", "modelPolicySha256", "evaluatorPolicySha256", "implementationSha256", "budgetPolicy", "promotionEnabled", "planSha256"],
  "properties": {
    "schemaVersion": { "const": "loop-factory-campaign-series-plan-v1" },
    "seriesId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "maximumWaves": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "familywiseAlpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
    "perWaveAlpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
    "maximumCalls": { "type": "integer", "minimum": 1 },
    "modelPolicySha256": { "$ref": "#/$defs/sha" },
    "evaluatorPolicySha256": { "$ref": "#/$defs/sha" },
    "implementationSha256": { "$ref": "#/$defs/sha" },
    "budgetPolicy": { "$ref": "vnext-resource-budget-v1.schema.json" },
    "promotionEnabled": { "const": false },
    "planSha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
