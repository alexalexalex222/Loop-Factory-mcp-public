{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "proofId", "createdAt", "proofHome", "request",
    "pairwiseReceipt", "prompt", "route", "runtimeAuthority",
    "identityPolicy", "invocationPolicy", "execution",
    "implementationManifest", "implementationSha256", "exposure",
    "approval", "planSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "loop-factory-vnext-evaluator-proof-plan-v2" },
    "proofId": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "proofHome": { "type": "string", "minLength": 1 },
    "request": {},
    "pairwiseReceipt": {},
    "prompt": { "type": "string", "minLength": 1 },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoningEffort", "authMode", "oauthAuthoritySha256", "executablePath", "executableSha256", "fallbackModels"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "authMode": { "const": "chatgpt-oauth" },
        "oauthAuthoritySha256": { "$ref": "#/$defs/sha" },
        "executablePath": { "type": "string", "minLength": 1 },
        "executableSha256": { "$ref": "#/$defs/sha" },
        "fallbackModels": { "type": "array", "maxItems": 0 }
      }
    },
    "runtimeAuthority": {},
    "identityPolicy": {},
    "invocationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "anonymousArmId", "modelGenerationSampling", "tools", "toolPolicy", "timeoutMs", "isolationPolicy", "separateProcess", "freshConversation", "isolatedHomeAuthCapsule"],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "anonymousArmId": { "$ref": "#/$defs/id" },
        "modelGenerationSampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "deterministic"],
          "properties": {
            "authority": { "const": "backend-default" },
            "deterministic": { "const": false }
          }
        },
        "tools": { "type": "array", "maxItems": 0 },
        "toolPolicy": { "const": "none" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "isolationPolicy": { "const": "codex-strict-v1" },
        "separateProcess": { "const": true },
        "freshConversation": { "const": true },
        "isolatedHomeAuthCapsule": { "const": true }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "outputSchemaPath", "outputSchemaSha256", "disabledFeatures"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "outputSchemaPath": { "type": "string", "minLength": 1 },
        "outputSchemaSha256": { "$ref": "#/$defs/sha" },
        "disabledFeatures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "implementationManifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha" }
        }
      }
    },
    "implementationSha256": { "$ref": "#/$defs/sha" },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumCalls", "retries", "hardTokenCeiling", "hardUsdCeiling", "billingMode", "promotionEnabled"],
      "properties": {
        "maximumCalls": { "const": 1 },
        "retries": { "const": 0 },
        "hardTokenCeiling": { "type": "null" },
        "hardUsdCeiling": { "const": 0 },
        "billingMode": { "const": "subscription-no-metered-usd" },
        "promotionEnabled": { "const": false }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredBeforeLaunch", "authority", "workerLaunchedAtPlanning", "paidModelCallsAtPlanning"],
      "properties": {
        "requiredBeforeLaunch": { "const": true },
        "authority": { "const": "operator-exact-evaluator-proof-plan-sha256" },
        "workerLaunchedAtPlanning": { "const": false },
        "paidModelCallsAtPlanning": { "const": 0 }
      }
    },
    "planSha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
