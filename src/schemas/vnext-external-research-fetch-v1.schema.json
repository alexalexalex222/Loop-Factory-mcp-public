{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "planSha256", "fetchedAt", "sourceCount", "totalRawBytes", "sources", "networkPerformed", "sealedMode", "activationAuthority", "promotionAuthority", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": "vnext-external-research-fetch-v1" },
    "planId": { "$ref": "#/$defs/id" },
    "planSha256": { "$ref": "#/$defs/sha" },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "sourceCount": { "type": "integer", "minimum": 1, "maximum": 32 },
    "totalRawBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
    "sources": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/source" } },
    "networkPerformed": { "const": true },
    "sealedMode": { "const": false },
    "activationAuthority": { "const": false },
    "promotionAuthority": { "const": false },
    "receiptSha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "title", "authorityClass", "retrievedAt", "content", "contentSha256", "rawSha256", "rawBytes", "excerptTruncated", "contentType", "remoteAddresses", "tlsAuthorized", "tlsProtocol", "rawPath"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 }, "authorityClass": { "const": "primary" },
        "retrievedAt": { "type": "string", "format": "date-time" }, "content": { "type": "string", "minLength": 1, "maxLength": 32000 },
        "contentSha256": { "$ref": "#/$defs/sha" }, "rawSha256": { "$ref": "#/$defs/sha" },
        "rawBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }, "excerptTruncated": { "type": "boolean" },
        "contentType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "remoteAddresses": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 64 } },
        "tlsAuthorized": { "const": true }, "tlsProtocol": { "type": ["string", "null"], "maxLength": 40 },
        "rawPath": { "type": "string", "pattern": "^raw/[A-Za-z0-9][A-Za-z0-9._-]{0,119}\\.bin$", "maxLength": 140 }
      }
    }
  }
}
