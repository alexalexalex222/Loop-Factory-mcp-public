{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "strategy", "targetBehavior", "component", "taskAgnostic", "prediction", "falsifier", "operations", "evidenceIds", "rollback", "protectedSurfaceTouches"],
  "properties": {
    "schemaVersion": { "const": "vnext-candidate-output-v1" },
    "strategy": { "enum": ["native", "reflective-pareto", "bounded-skill", "bank-recombination", "code-level-experimental"] },
    "targetBehavior": { "$ref": "#/$defs/text" },
    "component": { "type": "string", "minLength": 1, "maxLength": 120 },
    "taskAgnostic": { "type": "boolean" },
    "prediction": { "$ref": "#/$defs/text" },
    "falsifier": { "$ref": "#/$defs/text" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "target", "beforeSha256", "value"],
        "properties": {
          "op": { "enum": ["add", "delete", "replace", "recombine", "emit"] },
          "target": { "type": "string", "minLength": 1, "maxLength": 500 },
          "beforeSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "value": { "type": ["string", "null"], "maxLength": 8000 }
        }
      }
    },
    "evidenceIds": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" } },
    "rollback": { "$ref": "#/$defs/text" },
    "protectedSurfaceTouches": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
