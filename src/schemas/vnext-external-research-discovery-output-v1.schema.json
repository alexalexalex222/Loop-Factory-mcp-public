{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "abstain", "abstainReason", "searchSummary", "queries", "sources", "uncertainties"],
  "properties": {
    "schemaVersion": { "const": "vnext-external-research-discovery-output-v1" },
    "abstain": { "type": "boolean" },
    "abstainReason": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
    "searchSummary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/source" }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "abstain": { "const": true } }, "required": ["abstain"] },
      "then": {
        "properties": {
          "abstainReason": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "sources": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "abstainReason": { "type": "null" },
          "sources": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "url", "title", "reason", "authorityClass"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "authorityClass": { "const": "primary" }
      }
    }
  }
}
