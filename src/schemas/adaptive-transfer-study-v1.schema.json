{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "adaptive-transfer-study-v1",
  "title": "Headroom-qualified adaptive transfer study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "model",
    "fixtureOnly",
    "historicalTokenEstimate",
    "seed",
    "qualificationStopRule",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": "adaptive-transfer-study-v1" },
    "model": { "const": "gpt-5.6-sol" },
    "fixtureOnly": { "type": "boolean" },
    "historicalTokenEstimate": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "seed": { "type": "string", "minLength": 8 },
    "qualificationStopRule": {
      "const": "first-five-or-impossible-v1"
    },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "qualificationConfigPath",
          "confirmationConfigPath"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,119}$"
          },
          "qualificationConfigPath": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "^(?:/|\\.\\.(?:/|$))" }
          },
          "confirmationConfigPath": {
            "type": "string",
            "minLength": 1,
            "not": { "pattern": "^(?:/|\\.\\.(?:/|$))" }
          }
        }
      }
    }
  }
}
