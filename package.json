{
  "name": "super-loop-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An evidence-backed factory that mines workflows, tests improvements, and queues proven winners for human approval.",
  "bin": {
    "super-loop-mcp": "src/server.mjs",
    "super-loop-run": "scripts/run-campaign.mjs"
  },
  "main": "src/server.mjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "run-campaign": "node scripts/run-campaign.mjs",
    "real-test": "node scripts/run-campaign.mjs --real-test",
    "real-test:canary-plan": "node scripts/plan-real-test-canary.mjs",
    "real-test:canary": "node scripts/run-real-test-canary.mjs",
    "verify:canary": "node scripts/verify-canary.mjs",
    "meta-canary:plan": "node scripts/plan-adaptive-meta-canary.mjs",
    "meta-canary": "node scripts/run-adaptive-meta-canary.mjs",
    "verify:meta-canary": "node scripts/verify-adaptive-meta-canary.mjs",
    "executable-canary:plan": "node scripts/plan-adaptive-executable-canary.mjs",
    "executable-canary": "node scripts/run-adaptive-executable-canary.mjs",
    "verify:executable-canary": "node scripts/verify-adaptive-executable-canary.mjs",
    "transfer-cohort:plan": "node scripts/plan-adaptive-transfer-cohort.mjs",
    "transfer-cohort": "node scripts/run-adaptive-transfer-cohort.mjs",
    "verify:transfer-cohort": "node scripts/verify-adaptive-transfer-cohort.mjs",
    "transfer-study:plan": "node scripts/plan-adaptive-transfer-study.mjs",
    "transfer-study": "node scripts/run-adaptive-transfer-study.mjs",
    "verify:transfer-study": "node scripts/verify-adaptive-transfer-study.mjs",
    "verify:router-scale": "node scripts/verify-mechanism-router-scale.mjs",
    "recursive-canary:plan": "node scripts/plan-adaptive-recursive-canary.mjs",
    "recursive-canary:build-luna-r1": "node scripts/build-adaptive-recursive-luna-r1.mjs",
    "recursive-canary": "node scripts/run-adaptive-recursive-canary.mjs",
    "verify:recursive-canary": "node scripts/verify-adaptive-recursive-canary.mjs",
    "recursive-canary:v2:plan": "node scripts/plan-adaptive-recursive-canary-v2.mjs",
    "recursive-canary:v2": "node scripts/run-adaptive-recursive-canary-v2.mjs",
    "verify:recursive-canary:v2": "node scripts/verify-adaptive-recursive-canary-v2.mjs",
    "recursive-campaign:plan": "node scripts/plan-adaptive-recursive-campaign.mjs",
    "recursive-campaign": "node scripts/run-adaptive-recursive-campaign.mjs",
    "verify:recursive-campaign": "node scripts/verify-adaptive-recursive-campaign.mjs",
    "verify:run": "node scripts/verify-run.mjs",
    "verify:submission": "node scripts/verify-submission.mjs",
    "judge:gpt56-sol": "node scripts/judge-build-week.mjs",
    "proof:gpt56-sol": "node scripts/build-week-gpt56-proof.mjs",
    "proof:gpt56": "node scripts/build-week-gpt56-proof.mjs",
    "test": "node --test",
    "demo": "node scripts/demo.mjs",
    "verify": "node scripts/verify-sources.mjs"
  },
  "files": [
    "src/",
    "!src/*.bak-*",
    "loops/",
    "scripts/",
    "hosts/",
    "examples/",
    "docs/cover.png",
    "docs/ADAPTIVE_INTELLIGENCE_V1.md",
    "docs/ADAPTIVE_TRANSFER_STUDY_V1.md",
    "docs/EXECUTABLE_CAUSAL_CANARY_V1.md",
    "docs/EXECUTABLE_CAUSAL_CANARY_V2.md",
    "docs/EXECUTABLE_CAUSAL_CANARY_V3.md",
    "docs/EXECUTABLE_CAUSAL_CANARY_V4.md",
    "docs/RECURSIVE_MECHANISM_EVOLUTION_V1.md",
    "docs/RECURSIVE_HARNESS_V2.md",
    "docs/BUILD_WEEK_SUBMISSION.md",
    "docs/BUILD_WEEK_VIDEO.md",
    "docs/IMPROVEMENT_MEMORY.md",
    "docs/ROUTER_SCALE_GAUNTLET_V1.md",
    "docs/JUDGE_GUIDE.md",
    "docs/REAL_TEST_5X10.md",
    "submission/",
    "README.md"
  ],
  "license": "MIT"
}
