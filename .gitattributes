# Exact bundled-loop hashes require LF bytes in every checkout.
loops/strip-miner.txt text eol=lf
loops/loop-de-loop.md text eol=lf

# Cross-platform source and configuration files use deterministic LF bytes.
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tgz binary
